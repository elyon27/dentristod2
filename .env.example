# Set these in Netlify environment variables, with Functions scope.
SUPABASE_URL=https://YOUR_NEW_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Use a NEW project's sb_secret key. Legacy service_role JWT is also supported.
SITE_ORIGIN=https://YOUR_NEW_SITE.netlify.app
# Separate new reCAPTCHA v2 Checkbox keys for this new domain:
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Generate a random secret of at least 32 characters for hashing rate-limit IPs.
RATE_LIMIT_SECRET=
# Set true ONLY after importing all existing bookings and blocked dates.
AVAILABILITY_READY=false
